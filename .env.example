# ==============================================================================
# MADHURAI CHOCOLATE — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Network Configuration
PORT=4000
NODE_ENV=development

# Database Configuration
# Leave DATABASE_URL empty or unset to use the zero-configuration embedded database.
# For production PostgreSQL deployments, provide a full connection URI:
# DATABASE_URL=postgresql://madhurai_user:SecurePassword123@localhost:5432/madhurai_chocolate?sslmode=prefer
DATABASE_URL=

# Cryptographic & Session Secrets
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=c2e8a159f81d4e0e84b80b72183c749964e5c46e31c8901869818dc905ba2e74
JWT_EXPIRES_IN=7d

# Payment Gateway Configuration (Razorpay)
PAYMENT_GATEWAY=RAZORPAY
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Official Indian NPCI Dynamic UPI QR Merchant Handle
UPI_VPA=9676823113-2@ybl

# Frontends & CORS Configuration
APP_URL=http://localhost:4000
CUSTOMER_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001

# Production Domains (for reference):
# CUSTOMER_APP_URL=https://madhuraichocolates.in
# ADMIN_APP_URL=https://madhuraichocolates.in/admin
# APP_URL=https://madhuraichocolates.in

# Email & Transactional Notifications (SMTP)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USER=apikey
EMAIL_PASSWORD=SG.your_production_sendgrid_key_here
EMAIL_FROM="Madhurai Chocolate Care" <care@madhuraichocolates.in>
